exports.handler = async (event) => {
    const mysql = require('mysql2/promise');

    let body;
    try {
        body = typeof event.body === 'string' ? JSON.parse(event.body) : event.body;
    } catch (err) {
        console.error("Invalid JSON body", err);
        return {
            statusCode: 400,
            body: JSON.stringify({ error: "Invalid JSON body" })
        };
    }

    const key = body.key;
    const update = body.update;

    if (!key || !update) {
        return {
            statusCode: 400,
            body: JSON.stringify({ error: 'Missing one or more required parameters (key, update)' })
        };
    }

    const connection = await mysql.createConnection({
        host: 'mydb.cte2i8wsaut6.us-east-2.rds.amazonaws.com',
        user: 'admin',
        password: 'admin123',
        database: 'project',
        port: 3306
    });

    try {
        // Build SET and WHERE clauses
        const setClause = Object.keys(update).map(field => `${field} = ?`).join(', ');
        const setValues = Object.values(update);

        const whereClause = Object.keys(key).map(field => `${field} = ?`).join(' AND ');
        const whereValues = Object.values(key);

        const sql = `UPDATE emp SET ${setClause} WHERE ${whereClause}`;
        const values = [...setValues, ...whereValues];

        console.log("SQL:", sql);
        console.log("Values:", values);

        const [result] = await connection.execute(sql, values);

        if (result.changedRows === 0) {
            return {
                statusCode: 404,
                body: JSON.stringify({ message: "No rows updated. Either no match or data unchanged." })
            };
        }

        return {
            statusCode: 200,
            body: JSON.stringify({ message: "Employee updated successfully", result })
        };
    } catch (err) {
        console.error("Error during update:", err);
        return {
            statusCode: 500,
            body: JSON.stringify({ error: "Update failed", details: err.message })
        };
    } finally {
        await connection.end();
    }
};
