exports.handler = async (event) => {
    const mysql = require('mysql');

    const connection = mysql.createConnection({
        host: 'mydb.cte2i8wsaut6.us-east-2.rds.amazonaws.com',
        user: 'admin',
        password: 'admin123',
        database: 'project',
        port: 3306
    });

    return new Promise((resolve, reject) => {
        connection.connect((err) => {
            if (err) {
                console.error('Error connecting to the database: ', err);
                reject({
                    statusCode: 500,
                    body: JSON.stringify({ error: 'Connection error' })
                });
                return;
            }
        });

        const transactionId = event.queryStringParameters?.transactionId;
        const productId = event.queryStringParameters?.productId;

        if (!transactionId || !productId) {
            reject({
                statusCode: 400,
                body: JSON.stringify({ error: 'TransactionId and ProductId parameters are required' })
            });
            return;
        }

        const deleteQuery = 'DELETE FROM product WHERE TransactionId = ? AND ProductId = ?';
        connection.query(deleteQuery, [transactionId, productId], (err, results) => {
            connection.end();

            if (err) {
                console.error('Error during query: ', err);
                reject({
                    statusCode: 500,
                    body: JSON.stringify({ error: 'Query error' })
                });
            } else {
                if (results.affectedRows === 0) {
                    resolve({
                        statusCode: 404,
                        body: JSON.stringify({ message: `Product with ID ${productId} in Transaction ${transactionId} not found.` })
                    });
                } else {
                    resolve({
                        statusCode: 200,
                        body: JSON.stringify({ message: `Successfully deleted Product: ${productId} in Transaction: ${transactionId}` })
                    });
                }
            }
        });
    });
};