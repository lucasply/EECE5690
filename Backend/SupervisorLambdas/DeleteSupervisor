exports.handler = async (event) => {
    const mysql = require('mysql');

    const connection = mysql.createConnection({
        host: 'mydb.cte2i8wsaut6.us-east-2.rds.amazonaws.com',
        user: 'admin',
        password: 'admin123',
        database: 'project',
        port: 3306
    });

    return new Promise((resolve, reject) => {
        connection.connect((err) => {
            if (err) {
                console.error('Error connecting to the database: ', err);
                reject({
                    statusCode: 500,
                    body: JSON.stringify({ error: 'Connection error' })
                });
                return;
            }
        });

        const Id = event.queryStringParameters?.value;

        if (!Id) {
            reject({
                statusCode: 400,
                body: JSON.stringify({ error: 'CustomerId parameter is missing' })
            });
            return;
        }

        const deleteQuery = 'DELETE FROM supervisor WHERE Id = ?';
        connection.query(deleteQuery, [Id], (err, results) => {
            connection.end();
            if (err) {
                console.error('Error during query: ', err);
                reject({
                    statusCode: 500,
                    body: JSON.stringify({ error: 'Query error' })
                });
            } else {
                if (results.affectedRows === 0) {
                    resolve({
                        statusCode: 404,
                        body: JSON.stringify({ message: `Supervisor with ID ${Id} not found.` })
                    });
                } else {
                    resolve({
                        statusCode: 200,
                        body: JSON.stringify({ message: `Successfully deleted Supervisor: ${Id}` })
                    });
                }
            }
        });
    });
};
