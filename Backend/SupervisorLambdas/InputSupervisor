exports.handler = async (event) => {
    const mysql = require('mysql');

    const connection = mysql.createConnection({
        host: 'mydb.cte2i8wsaut6.us-east-2.rds.amazonaws.com',
        user: 'admin',
        password: 'admin123',
        database: 'project',
        port: 3306
    });

    return new Promise((resolve, reject) => {
        connection.connect((err) => {
            if (err) {
                console.error('Error connecting to the database: ', err);
                reject({
                    statusCode: 500,
                    headers: {
                        "Access-Control-Allow-Origin": "*",
                        "Access-Control-Allow-Headers": "Content-Type",
                        "Access-Control-Allow-Methods": "OPTIONS,POST"
                    },
                    body: JSON.stringify({ error: 'Connection error' })
                });
                return;
            }
            console.log('Connected to the database');

            let parsedBody;
            try {
                parsedBody = JSON.parse(event.body);
            } catch (parseError) {
                console.error('Error parsing request body: ', parseError);
                reject({
                    statusCode: 400,
                    headers: {
                        "Access-Control-Allow-Origin": "*",
                        "Access-Control-Allow-Headers": "Content-Type",
                        "Access-Control-Allow-Methods": "OPTIONS,POST"
                    },
                    body: JSON.stringify({ error: 'Invalid JSON in request body' })
                });
                connection.end();
                return;
            }

            const { Id, SupervisorId, Role, Department } = parsedBody.data;

            if (
                Id === undefined || 
                SupervisorId === undefined || 
                Role === undefined || 
                Department === undefined
            ) {
                reject({
                    statusCode: 400,
                    headers: {
                        "Access-Control-Allow-Origin": "*",
                        "Access-Control-Allow-Headers": "Content-Type",
                        "Access-Control-Allow-Methods": "OPTIONS,POST"
                    },
                    body: JSON.stringify({ error: 'Missing one or more required parameters' })
                });
                connection.end();
                return;
            }

            connection.query(
                'INSERT INTO supervisor (Id, SupervisorId, Role, Department) VALUES (?, ?, ?, ?)',
                [Id, SupervisorId, Role, Department],
                (err, results) => {
                    if (err) {
                        if (err.code === 'ER_DUP_ENTRY') {
                            reject({
                                statusCode: 400,
                                headers: {
                                    "Access-Control-Allow-Origin": "*",
                                    "Access-Control-Allow-Headers": "Content-Type",
                                    "Access-Control-Allow-Methods": "OPTIONS,POST"
                                },
                                body: JSON.stringify({ error: 'Duplicate Supervisor Id' })
                            });
                        } else {
                            console.error('Error during query: ', err);
                            reject({
                                statusCode: 500,
                                headers: {
                                    "Access-Control-Allow-Origin": "*",
                                    "Access-Control-Allow-Headers": "Content-Type",
                                    "Access-Control-Allow-Methods": "OPTIONS,POST"
                                },
                                body: JSON.stringify({ error: 'Query error' })
                            });
                        }
                        connection.end();
                        return;
                    }

                    console.log('Query results: ', results);
                    resolve({
                        statusCode: 200,
                        headers: {
                            "Access-Control-Allow-Origin": "*",
                            "Access-Control-Allow-Headers": "Content-Type",
                            "Access-Control-Allow-Methods": "OPTIONS,POST"
                        },
                        body: JSON.stringify({ message: 'Supervisor added successfully', results })
                    });

                    connection.end();
                }
            );
        });
    });
};